root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,hh,cpp,cxx,cc,inl}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{cs,Build.cs,Target.cs}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,uproject,uplugin}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false
